{
  // Single deployed Worker: static web assets + /api/v1/* + scheduled handler (D-008, D-020, D-021).
  // No secrets belong in this file. Secrets are set with `wrangler secret put` (docs/CREDENTIALS.md).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "autopw3",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    "ENVIRONMENT": "local",
    "LOCAL_MOCKS": "true",
    "PROVIDER_MODE": "mock",
    "ALLOWED_ORIGINS": "http://localhost:5173",
    "APP_BASE_URL": "http://localhost:5173",
  },
  "env": {
    "staging": {
      "name": "autopw3-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "LOCAL_MOCKS": "false",
        "PROVIDER_MODE": "mock",
        "ALLOWED_ORIGINS": "https://staging.autopw3.example.com",
      },
    },
    "production": {
      "name": "autopw3",
      "vars": {
        "ENVIRONMENT": "production",
        "LOCAL_MOCKS": "false",
        "PROVIDER_MODE": "live",
        "ALLOWED_ORIGINS": "https://autopw3.example.com",
      },
    },
  },
}
