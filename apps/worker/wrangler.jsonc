{
  // Single deployed Worker: static web assets + /api/v1/* + scheduled handler (D-008, D-020, D-021).
  // No secrets belong in this file. Secrets are set with `wrangler secret put` (docs/CREDENTIALS.md).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "autopw3",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    "ENVIRONMENT": "local",
    "LOCAL_MOCKS": "true",
    "PROVIDER_MODE": "mock",
    "ALLOWED_ORIGINS": "http://localhost:5173",
    "APP_BASE_URL": "http://localhost:5173",
  },
  "env": {
    "staging": {
      "name": "autopw3-yourname-staging",
      "assets": {
        "directory": "../web/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"],
      },
      "vars": {
        "ENVIRONMENT": "staging",
        "LOCAL_MOCKS": "false",
        "PROVIDER_MODE": "mock",
        "ALLOWED_ORIGINS": "https://staging.example.invalid",
        "APP_BASE_URL": "https://staging.example.invalid",
        "STAGING_IDENTITY_READ_ENABLED": "true",
        "STAGING_TESLA_OAUTH_ENABLED": "true",
        "STAGING_TESLA_LIVE_STATUS_ENABLED": "false",
        "STAGING_TESLA_SITES_ENABLED": "true",
        "TESLA_CLIENT_ID": "YOUR_TESLA_CLIENT_ID",
        "TESLA_REDIRECT_URI": "https://staging.example.invalid/api/v1/provider/tesla/callback",
        "TESLA_FLEET_API_BASE_URL": "https://fleet-api.prd.eu.vn.cloud.tesla.com",
        "SUPABASE_URL": "https://YOUR_PROJECT_REF.supabase.co",
        "SUPABASE_ANON_KEY": "YOUR_SUPABASE_PUBLIC_KEY",
      },
    },
    "production": {
      "name": "autopw3",
      "vars": {
        "ENVIRONMENT": "production",
        "LOCAL_MOCKS": "false",
        "PROVIDER_MODE": "live",
        "ALLOWED_ORIGINS": "https://autopw3.example.com",
      },
    },
  },
}
