{
  // Single deployed Worker: static web assets + /api/v1/* + scheduled handler (D-008, D-020, D-021).
  // No secrets belong in this file. Secrets are set with `wrangler secret put` (docs/CREDENTIALS.md).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "autopw3",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "triggers": {
    // Cron timing is approximate; jobs are idempotent and claimed from the database (D-007).
    "crons": ["* * * * *"],
  },
  "vars": {
    "ENVIRONMENT": "local",
    "PROVIDER_MODE": "demo",
    "ALLOWED_ORIGINS": "http://localhost:5173",
  },
  "env": {
    "staging": {
      "name": "autopw3-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "PROVIDER_MODE": "live",
        "ALLOWED_ORIGINS": "https://staging.autopw3.example.com",
        "TESLA_REDIRECT_URI": "https://staging.autopw3.example.com/api/v1/oauth/tesla/callback",
      },
    },
    "production": {
      "name": "autopw3",
      "vars": {
        "ENVIRONMENT": "production",
        "PROVIDER_MODE": "live",
        "ALLOWED_ORIGINS": "https://autopw3.example.com",
        "TESLA_REDIRECT_URI": "https://autopw3.example.com/api/v1/oauth/tesla/callback",
      },
    },
  },
}
