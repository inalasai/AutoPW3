# Copy to apps/web/.env.local. Default development needs no account or secrets.
VITE_DEMO_MODE=true
VITE_TELEMETRY_PROVIDER=demo
# API requests use same-origin /api/v1; no API-base environment variable is consumed.
# For your own Supabase/local stack only: disable demo and fill these public values.
# VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY
# Development-only mock sign-in: VITE_DEMO_MODE=false and VITE_AUTH_MODE=mock.
# Production/staging builds refuse VITE_AUTH_MODE=mock.
