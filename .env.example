# AutoPW3 environment variables — PLACEHOLDERS ONLY. Never put real values in this file.
# Reference only; use the per-app examples. See docs/DEVELOPER_SETUP.md for active runtime bindings.

# ---- Web app (apps/web) — copy to .env.local. VITE_ variables are PUBLIC; never put secrets here ----
VITE_DEMO_MODE=true
# TASK-09: where the Live View reads from: demo or live. Unset means demo in demo mode and live otherwise.
# live needs VITE_DEMO_MODE=false and has no provider until TASKs 14 to 16, so the page says so and shows no data.
# VITE_TELEMETRY_PROVIDER=demo
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_VALUE_HERE
# API calls are same-origin /api/v1; Vite proxies /api to localhost:8787.
# TASK-07, development only: "mock" replaces Supabase Auth with an in-memory identity provider (no credentials).
# Needs VITE_DEMO_MODE=false. A production build refuses it. See docs/AUTHENTICATION_SETUP.md.
# VITE_AUTH_MODE=mock

# ---- Worker (apps/worker) — local: apps/worker/.dev.vars ; production: Cloudflare secrets ----
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_VALUE_HERE
# Server-only. Bypasses RLS. Use only where documented in docs/API_OPERATIONS.md.
SUPABASE_SECRET_KEY=YOUR_VALUE_HERE
ALLOWED_ORIGINS=http://localhost:5173
APP_BASE_URL=http://localhost:5173
# Optional JWT_ISSUER / JWT_JWKS_URL normally remain unset; staging pins them to this Supabase project.

# Tesla Fleet API (names and regions confirmed in TASK-00; live use is UNVERIFIED until tested)
TESLA_CLIENT_ID=YOUR_VALUE_HERE
TESLA_CLIENT_SECRET=YOUR_VALUE_HERE
TESLA_REDIRECT_URI=https://YOUR_APP_HOST/api/v1/provider/tesla/callback

# Token encryption (generate a random 32-byte key; keep a versioned copy in a password manager)
TOKEN_ENCRYPTION_KEY=YOUR_VALUE_HERE
# Runtime currently uses envelope key version 1; no environment-driven key-rotation switch exists.

# ---- Added by TASK-02 (names only; see docs/SYSTEM_ARCHITECTURE.md sections 8 and 11) ----
# Non-secret deployment label. Set under "vars" in apps/worker/wrangler.jsonc, not as a secret.
ENVIRONMENT=local
# Explicit opt-in for process-local Worker mocks. Never set true for staging/production.
LOCAL_MOCKS=true
# Independent staging identity gate. No other API is enabled by this flag.
STAGING_IDENTITY_READ_ENABLED=false
# Separate staging-only read-only OAuth opt-in. No telemetry, commands or cron.
STAGING_TESLA_OAUTH_ENABLED=false
# Separate staging-only discovery/linking gate. Does not enable live status or controls.
STAGING_TESLA_SITES_ENABLED=false
# Separate manual read-only Tesla live-status gate; no telemetry persistence or scheduled work.
STAGING_TESLA_LIVE_STATUS_ENABLED=false
# Mock provider is used locally and by the isolated staging OAuth/site workflow; production stays gated.
PROVIDER_MODE=mock
# Explicit NA/EU origin from Tesla Regions and Countries; no fallback.
TESLA_FLEET_API_BASE_URL=YOUR_VALUE_HERE
# The household spend cap is a database setting; it is not a Worker environment variable.

# ---- CI only (GitHub Actions secrets, not files) ----
# CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID, SUPABASE_ACCESS_TOKEN, SUPABASE_DB_PASSWORD
